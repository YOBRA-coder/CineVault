# All optional. Export these (or set them in Render -> Environment) before starting the app.
PORT=10000
HOST=127.0.0.1            # use 0.0.0.0 to share on your network
CINEVAULT_DB=             # database file path (Render: /var/data/cinevault.db on a mounted disk)
ADMIN_TOKEN=              # REQUIRED to use /admin on a server (without it, admin only works from localhost)
AUTO_IMPORT=0             # e.g. 300 = on first boot import 300 public-domain films from archive.org
AUTO_SYNC=1               # verify archive.org files in the background on start
PROXY_STREAM=1            # 1 = playback passes through this server; 0 = straight from archive.org (saves bandwidth)
PROXY_DOWNLOAD=1          # 1 = downloads are saved with clean file names through this server; 0 = redirect
TMDB_API_KEY=             # optional: turns on Discover (any movie/series, trailers, where to watch) + real posters/cast. v3 key or v4 token, free at themoviedb.org
