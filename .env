# All optional. Export these (or set them in your shell) before running `python app.py`.
PORT=5000
HOST=127.0.0.1            # use 0.0.0.0 to share on your network
AUTO_SYNC=1               # verify archive.org files in the background on start
PROXY_MEDIA=1             # 1 = stream/download through this server (named files, logging); 0 = redirect straight to archive.org (saves your bandwidth)
TMDB_API_KEY=             # optional: real posters, backdrops and full cast (free key at themoviedb.org)
ADMIN_TOKEN=              # protects /api/admin/* when exposed beyond localhost
